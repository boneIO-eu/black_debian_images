# Disk images
*.img
*.img.xz
*.img.gz
*.img.bz2

# Test scripts
scripts/test_*.sh

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# AI working plans — local scratch, not committed. See AGENTS.md.
.ai-plans/

# Local pointer so Claude Code picks up AGENTS.md; the rules themselves are
# in AGENTS.md, which is tracked.
CLAUDE.md

# Generated config caches. boneIO rebuilds these from config.yaml whenever the
# hash stops matching, so a committed copy was only ever a head start — and one
# that showed up as a dirty tree after every local run. generate_all_images.sh
# refreshes them from ../app_black before it builds; without that checkout an
# image simply ships without a warm cache and the app builds one on first boot.
configs/*/*/config.yaml.cache.pkl

# Downloads kept between offline builds (scripts/build_rootfs_offline.sh).
.build-cache/
# Offline build logs, next to the image they describe.
*.build.log
