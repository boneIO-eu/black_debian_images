#!/bin/bash -e

if ! id | grep -q root; then
	echo "must be run as root:"
	exit
fi

version_message="3.1.0, dd-based flasher - reads /boneio-emmc.img from root filesystem..."

# Configuration
IMAGE_FILE="/boneio-emmc.img"
DESTINATION="/dev/mmcblk1"
OLED_SCRIPT="/usr/sbin/oled_msg.sh"

# Display message on OLED (safe to call without OLED connected)
oled_msg() {
	if [ -x "${OLED_SCRIPT}" ]; then
		${OLED_SCRIPT} "$@" &
	fi
}

cylon_leds() {
	local leds_base=/sys/class/leds/beaglebone\:green\:usr
	if [ -e ${leds_base}0/trigger ] ; then
		echo none > ${leds_base}0/trigger || true
		echo none > ${leds_base}1/trigger || true
		echo none > ${leds_base}2/trigger || true
		echo none > ${leds_base}3/trigger || true

		STATE=1
		while : ; do
		case $STATE in
			1)
				echo 1 > ${leds_base}0/brightness || true
				echo 0 > ${leds_base}1/brightness || true
				echo 0 > ${leds_base}2/brightness || true
				echo 0 > ${leds_base}3/brightness || true
				STATE=2
				;;
			2)
				echo 0 > ${leds_base}0/brightness || true
				echo 1 > ${leds_base}1/brightness || true
				echo 0 > ${leds_base}2/brightness || true
				echo 0 > ${leds_base}3/brightness || true
				STATE=3
				;;
			3)
				echo 0 > ${leds_base}0/brightness || true
				echo 0 > ${leds_base}1/brightness || true
				echo 1 > ${leds_base}2/brightness || true
				echo 0 > ${leds_base}3/brightness || true
				STATE=4
				;;
			4)
				echo 0 > ${leds_base}0/brightness || true
				echo 0 > ${leds_base}1/brightness || true
				echo 0 > ${leds_base}2/brightness || true
				echo 1 > ${leds_base}3/brightness || true
				STATE=5
				;;
			5)
				echo 0 > ${leds_base}0/brightness || true
				echo 0 > ${leds_base}1/brightness || true
				echo 1 > ${leds_base}2/brightness || true
				echo 0 > ${leds_base}3/brightness || true
				STATE=6
				;;
			6)
				echo 0 > ${leds_base}0/brightness || true
				echo 1 > ${leds_base}1/brightness || true
				echo 0 > ${leds_base}2/brightness || true
				echo 0 > ${leds_base}3/brightness || true
				STATE=1
				;;
			*)
				STATE=1
				;;
		esac
		sleep 0.1
		done
	fi
}

all_leds_on() {
	local leds_base=/sys/class/leds/beaglebone\:green\:usr
	if [ -e ${leds_base}0/trigger ] ; then
		echo 1 > ${leds_base}0/brightness || true
		echo 1 > ${leds_base}1/brightness || true
		echo 1 > ${leds_base}2/brightness || true
		echo 1 > ${leds_base}3/brightness || true
	fi
}

broadcast () {
	if [ "x${message}" != "x" ] ; then
		echo "${message}"
	fi
}

stabilize_system () {
	message="INFO: Giving system time to stabilize..." ; broadcast

	# Mount essential pseudo-filesystems (needed when running as init)
	if [ ! -e /proc/cmdline ] ; then
		message="INFO: Mounting /proc" ; broadcast
		mount -t proc proc /proc
	fi
	if [ ! -e /sys/class ] ; then
		message="INFO: Mounting /sys" ; broadcast
		mount -t sysfs sysfs /sys
	fi
	if [ ! -e /dev/mmcblk0 ] ; then
		message="INFO: Mounting /dev" ; broadcast
		mount -t devtmpfs devtmpfs /dev
	fi

	message="INFO: Preparing /tmp" ; broadcast
	mount -t tmpfs tmpfs /tmp 2>/dev/null || true

	if [ -f /proc/sys/vm/min_free_kbytes ] ; then
		message="INFO: [sysctl -w vm.min_free_kbytes=16384]" ; broadcast
		sysctl -w vm.min_free_kbytes=16384 || true
	fi

	# Load I2C module for OLED display
	modprobe i2c-dev 2>/dev/null || true

	# Load MMC/eMMC kernel modules (may be needed if not built-in)
	message="INFO: Loading MMC kernel modules..." ; broadcast
	modprobe mmc_block 2>/dev/null || true
	modprobe omap_hsmmc 2>/dev/null || true
	modprobe sdhci-omap 2>/dev/null || true

	sleep 3
	message="INFO: System stabilized" ; broadcast
	message="--------------------------------------------------------------------------------" ; broadcast
}

# Progress monitor - persistent Python process that polls dd's write progress
# via /proc/PID/io and updates OLED without flicker (single device init)
progress_monitor() {
	local total_bytes="$1"
	local dd_pid="$2"
	python3 - "$total_bytes" "$dd_pid" << 'PYEOF' &
import sys, time, os

total_bytes = int(sys.argv[1])
dd_pid = sys.argv[2]

# Initialize OLED once (no flicker on updates)
device = None
font = None
try:
    from luma.core.interface.serial import i2c
    from luma.core.render import canvas
    from luma.oled.device import sh1106
    from PIL import ImageFont
    serial = i2c(port=2, address=0x3C)
    device = sh1106(serial)
    device.persist = True
    font = ImageFont.load_default()
except Exception:
    pass

def draw(line1, line2, line3):
    if device and font:
        try:
            with canvas(device) as d:
                d.text((8, 12), line1, font=font, fill="white")
                d.text((8, 28), line2, font=font, fill="white")
                d.text((8, 44), line3, font=font, fill="white")
        except Exception:
            pass

def get_write_bytes(pid):
    """Read write_bytes from /proc/PID/io."""
    try:
        with open(f"/proc/{pid}/io", "r") as f:
            for line in f:
                if line.startswith("write_bytes:"):
                    return int(line.split()[1])
    except Exception:
        pass
    return 0

start = time.time()
draw("Flashing eMMC", "[----------] 0%", "Starting...")

while os.path.exists(f"/proc/{dd_pid}"):
    written = get_write_bytes(dd_pid)
    elapsed = int(time.time() - start)
    mins, secs = divmod(elapsed, 60)

    if total_bytes > 0:
        pct = min(written * 100 // total_bytes, 100)
    else:
        pct = 0

    filled = pct // 10
    bar = "=" * filled + "-" * (10 - filled)
    draw("Flashing eMMC", f"[{bar}] {pct}%", f"{mins}m {secs}s")
    print(f"INFO: Progress: {pct}% ({mins}m {secs}s elapsed)", flush=True)

    time.sleep(10)

draw("Flashing eMMC", "[==========] 100%", "Syncing...")
print("INFO: Progress: 100% — dd finished", flush=True)
PYEOF
	PROGRESS_PID=$!
}

stop_progress_monitor() {
	if [ -n "$PROGRESS_PID" ] && [ -e /proc/$PROGRESS_PID ]; then
		kill $PROGRESS_PID > /dev/null 2>&1 || true
	fi
	PROGRESS_PID=""
}

write_failure () {
	message="ERROR: writing to [${DESTINATION}] failed..." ; broadcast
	stop_progress_monitor

	if [ "x${has_usr_leds}" = "xenable" ] ; then
		if [ -n "$CYLON_PID" ]; then
			kill $CYLON_PID > /dev/null 2>&1 || true
		fi
		# Blink all LEDs as error indicator
		leds_base=/sys/class/leds/beaglebone\:green\:usr
		while : ; do
			echo 1 > ${leds_base}0/brightness || true
			echo 1 > ${leds_base}1/brightness || true
			echo 1 > ${leds_base}2/brightness || true
			echo 1 > ${leds_base}3/brightness || true
			sleep 0.5
			echo 0 > ${leds_base}0/brightness || true
			echo 0 > ${leds_base}1/brightness || true
			echo 0 > ${leds_base}2/brightness || true
			echo 0 > ${leds_base}3/brightness || true
			sleep 0.5
		done
	fi
	exit 1
}

startup_checks () {
	message="INFO: ===============================================" ; broadcast
	message="INFO: DD-based eMMC flasher ${version_message}" ; broadcast
	message="INFO: ===============================================" ; broadcast
	message="INFO: Image file: ${IMAGE_FILE}" ; broadcast
	message="INFO: ===============================================" ; broadcast

	has_usr_leds="enable"

	if [ "x${has_usr_leds}" = "xenable" ] ; then
		cylon_leds & CYLON_PID=$!
	fi

	# Wait for eMMC device to appear (may take a few seconds at boot)
	message="INFO: Waiting for eMMC device..." ; broadcast
	WAIT_COUNT=0
	while [ ! -b "${DESTINATION}" ] && [ $WAIT_COUNT -lt 30 ]; do
		sleep 1
		WAIT_COUNT=$((WAIT_COUNT + 1))
		echo "INFO: Waiting for ${DESTINATION}... (${WAIT_COUNT}s)"
	done

	# Check destination exists
	if [ ! -b "${DESTINATION}" ] ; then
		message="ERROR: [${DESTINATION}] does not exist" ; broadcast
		message="INFO: Available block devices:" ; broadcast
		ls -la /dev/mmcblk* /dev/sd* 2>/dev/null || true
		lsblk 2>/dev/null || true
		write_failure
	fi
	message="INFO: Destination [${DESTINATION}] OK" ; broadcast
}

find_image_file () {
	message="INFO: Looking for image file..." ; broadcast

	if [ -f "${IMAGE_FILE}" ] ; then
		IMAGE_SIZE=$(stat -c%s "${IMAGE_FILE}")
		message="INFO: Found image: ${IMAGE_FILE} ($(numfmt --to=iec ${IMAGE_SIZE}))" ; broadcast
	else
		message="ERROR: Image file not found: ${IMAGE_FILE}" ; broadcast
		message="INFO: Available files in /:" ; broadcast
		ls -la /*.img 2>/dev/null || echo "No .img files found"
		write_failure
	fi
	message="--------------------------------------------------------------------------------" ; broadcast
}

flash_emmc () {
	message="INFO: Flashing eMMC..." ; broadcast

	message="INFO: [dd if=${IMAGE_FILE} of=${DESTINATION} bs=4M]" ; broadcast
	message="--------------------------------------------------------------------------------" ; broadcast

	# Run dd in background so we can monitor progress
	dd if="${IMAGE_FILE}" of="${DESTINATION}" bs=4M 2>/dev/null &
	local DD_PID=$!

	# Start OLED progress monitor (polls /proc/$DD_PID/io every 10s)
	progress_monitor "${IMAGE_SIZE}" "${DD_PID}"

	# Wait for dd to finish
	wait $DD_PID || write_failure

	# Stop progress monitor
	stop_progress_monitor

	message="--------------------------------------------------------------------------------" ; broadcast
	message="INFO: Write complete, syncing..." ; broadcast
	sync
	blockdev --flushbufs ${DESTINATION} || true

	message="INFO: Forcing eMMC readback to flush write cache..." ; broadcast
	dd if=${DESTINATION} of=/dev/null bs=4M count=100 status=progress || true
	sync

	message="--------------------------------------------------------------------------------" ; broadcast
	message="INFO: Flash complete!" ; broadcast
}

fix_emmc_rootfs () {
	message="INFO: Fixing eMMC rootfs configuration..." ; broadcast
	oled_msg "Preparing system..." "Please wait"

	# Re-read partition table after dd
	message="INFO: Re-reading partition table on ${DESTINATION}..." ; broadcast
	partprobe ${DESTINATION} 2>/dev/null || true
	blockdev --rereadpt ${DESTINATION} 2>/dev/null || true
	sleep 2

	# Find ext4 partition on eMMC (rootfs)
	EMMC_ROOTFS=""
	media_rootfs=""
	for i in 1 2 3; do
		if [ -b "${DESTINATION}p${i}" ]; then
			PART="${DESTINATION}p${i}"
		elif [ -b "${DESTINATION}${i}" ]; then
			PART="${DESTINATION}${i}"
		else
			continue
		fi

		FS_TYPE=$(blkid -s TYPE -o value "$PART" 2>/dev/null || echo "unknown")
		if [ "$FS_TYPE" = "ext4" ]; then
			EMMC_ROOTFS="$PART"
			media_rootfs="$i"
			break
		fi
	done

	if [ -z "$EMMC_ROOTFS" ]; then
		message="WARNING: Could not find eMMC rootfs partition, skipping fstab fix" ; broadcast
		return
	fi

	message="INFO: Found eMMC rootfs: ${EMMC_ROOTFS} (partition ${media_rootfs})" ; broadcast

	# Expand rootfs partition to fill entire eMMC
	message="INFO: Expanding partition ${media_rootfs} on ${DESTINATION}..." ; broadcast
	if command -v growpart >/dev/null 2>&1; then
		growpart ${DESTINATION} ${media_rootfs} || true
		message="INFO: growpart done" ; broadcast
	else
		message="INFO: growpart not available, using sfdisk..." ; broadcast
		echo ", +" | sfdisk -N ${media_rootfs} ${DESTINATION} --force 2>/dev/null || true
	fi
	partprobe ${DESTINATION} 2>/dev/null || true
	sleep 1

	# Resize ext4 filesystem to fill expanded partition
	message="INFO: Resizing filesystem on ${EMMC_ROOTFS}..." ; broadcast
	e2fsck -f -y ${EMMC_ROOTFS} 2>/dev/null || true
	resize2fs ${EMMC_ROOTFS} || true
	message="INFO: Filesystem resize complete" ; broadcast

	mkdir -p /tmp/rootfs/ || true
	if ! mount "${EMMC_ROOTFS}" /tmp/rootfs/ -o async,noatime 2>/dev/null; then
		message="WARNING: Could not mount eMMC rootfs" ; broadcast
		return
	fi

	# Generate /etc/fstab with correct eMMC device paths
	message="INFO: Generating: /etc/fstab" ; broadcast
	echo "# /etc/fstab: static file system information." > /tmp/rootfs/etc/fstab
	echo "#" >> /tmp/rootfs/etc/fstab
	echo "${DESTINATION}p${media_rootfs}  /  ext4  noatime,errors=remount-ro  0  1" >> /tmp/rootfs/etc/fstab

	if [ "x${media_rootfs}" = "x2" ] ; then
		echo "${DESTINATION}p1  /boot/firmware vfat user,uid=1000,gid=1000,defaults 0 2" >> /tmp/rootfs/etc/fstab
	fi

	if [ "x${media_rootfs}" = "x3" ] ; then
		echo "${DESTINATION}p1  /boot/firmware vfat user,uid=1000,gid=1000,defaults 0 2" >> /tmp/rootfs/etc/fstab
		echo "${DESTINATION}p2       none    swap    sw      0       0" >> /tmp/rootfs/etc/fstab
	fi

	echo "debugfs  /sys/kernel/debug  debugfs  mode=755,uid=root,gid=gpio,defaults  0  0" >> /tmp/rootfs/etc/fstab
	message="INFO: [cat /tmp/rootfs/etc/fstab]" ; broadcast
	cat /tmp/rootfs/etc/fstab
	message="--------------------------------------------------------------------------------" ; broadcast

	# Disable flasher cmdline in eMMC uEnv.txt
	if [ -f /tmp/rootfs/boot/uEnv.txt ]; then
		sed -i -e 's:cmdline=init:#cmdline=init:g' /tmp/rootfs/boot/uEnv.txt
		message="INFO: Disabled flasher cmdline in eMMC uEnv.txt" ; broadcast
	fi

	# Update generic-sys-mods if present
	if [ -f /tmp/rootfs/etc/default/generic-sys-mods ] ; then
		. /tmp/rootfs/etc/default/generic-sys-mods
		echo "#This file is sourced by /usr/bin/bb-growpart" > /tmp/rootfs/etc/default/generic-sys-mods
		echo "ROOT_DRIVE=${DESTINATION}" >> /tmp/rootfs/etc/default/generic-sys-mods
		echo "ROOT_PARTITION=${ROOT_PARTITION}" >> /tmp/rootfs/etc/default/generic-sys-mods
		echo "ARCH_SOC_MODULES=${ARCH_SOC_MODULES}" >> /tmp/rootfs/etc/default/generic-sys-mods
		message="INFO: Updated generic-sys-mods" ; broadcast
	fi

	# Remove pishrink resize2fs_once (references wrong device from SD image)
	if [ -f /tmp/rootfs/etc/init.d/resize2fs_once ] ; then
		rm -f /tmp/rootfs/etc/init.d/resize2fs_once || true
		rm -f /tmp/rootfs/etc/rc2.d/*resize2fs_once 2>/dev/null || true
		rm -f /tmp/rootfs/etc/rc3.d/*resize2fs_once 2>/dev/null || true
		rm -f /tmp/rootfs/etc/rc5.d/*resize2fs_once 2>/dev/null || true
		message="INFO: Removed resize2fs_once (not needed, partition already expanded)" ; broadcast
	fi

	# Remove grow_partition service (references wrong device from SD image)
	if [ -f /tmp/rootfs/etc/systemd/system/multi-user.target.wants/grow_partition.service ] ; then
		rm -f /tmp/rootfs/etc/systemd/system/multi-user.target.wants/grow_partition.service || true
		message="INFO: Removed grow_partition.service" ; broadcast
	fi

	# Generate SSH host keys (so bbbio-set-sysconf doesn't need to reboot)
	message="INFO: Generating SSH host keys..." ; broadcast
	ssh-keygen -q -t rsa -N "" -f /tmp/rootfs/etc/ssh/ssh_host_rsa_key 2>/dev/null || true
	ssh-keygen -q -t ecdsa -N "" -f /tmp/rootfs/etc/ssh/ssh_host_ecdsa_key 2>/dev/null || true
	ssh-keygen -q -t ed25519 -N "" -f /tmp/rootfs/etc/ssh/ssh_host_ed25519_key 2>/dev/null || true
	# Remove ssh_regenerate flag so bbbio-set-sysconf skips keygen + reboot
	rm -f /tmp/rootfs/etc/bbb.io/ssh_regenerate 2>/dev/null || true
	message="INFO: SSH host keys generated" ; broadcast

	# Clean rc.local from pishrink fdisk/resize commands (reference wrong device)
	if [ -f /tmp/rootfs/etc/rc.local ] ; then
		cat > /tmp/rootfs/etc/rc.local <<'RCEOF'
#!/bin/sh -e
#
# rc.local - executed at the end of each multiuser runlevel
#
exit 0
RCEOF
		chmod +x /tmp/rootfs/etc/rc.local
		message="INFO: Cleaned rc.local (resize commands removed)" ; broadcast
	fi

	sync
	umount /tmp/rootfs/ || umount -l /tmp/rootfs/ || true
	message="INFO: eMMC rootfs configuration fixed" ; broadcast
	message="--------------------------------------------------------------------------------" ; broadcast
}

cleanup_and_shutdown () {
	message="INFO: Cleanup..." ; broadcast
	sync
	
	# Stop cylon animation
	if [ -n "$CYLON_PID" ]; then
		kill $CYLON_PID > /dev/null 2>&1 || true
	fi

	message="" ; broadcast
	message="INFO: ===============================================" ; broadcast
	message="INFO: SUCCESS: eMMC flashed successfully!" ; broadcast
	message="INFO: ===============================================" ; broadcast
	message="INFO: Remove SD card and reboot" ; broadcast
	message="INFO: ===============================================" ; broadcast
	oled_msg "Flash complete!" "Remove SD card" "and reboot."
	message="" ; broadcast

	# All LEDs on = success
	all_leds_on
	
	# Give user time to see success message
	sleep 10

	sync

	if [ -f /proc/sysrq-trigger ] ; then
		message="INFO: Syncing and powering off via sysrq..." ; broadcast
		echo s > /proc/sysrq-trigger
		sleep 1
		echo o > /proc/sysrq-trigger
	fi

	# Fallback if sysrq did not work
	sleep 5

	# When running as init, try to hand off to real init
	exec /sbin/init
	# Should not reach here
	halt -f
}

### Main ###

stabilize_system
startup_checks
find_image_file
flash_emmc
fix_emmc_rootfs
cleanup_and_shutdown
