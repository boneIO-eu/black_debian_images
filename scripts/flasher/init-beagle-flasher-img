#!/bin/bash -e
#
# init-beagle-flasher-img — writes /boneio-emmc.img to the eMMC and then either
# powers the board down or boots it as a test station.
#
# Runs as PID 1 from the SD card. Every setting comes from boneio.txt on the SD
# card's FAT32 boot partition, which is sourced as shell — see
# scripts/flasher/boneio.txt.example.
#
#   BOARD_VERSION=0.8 | 1.0 | 1.1
#       Which board is being flashed. Picks the device-tree overlay and the
#       config. Leave it unset to probe I2C2 for a DS2484 at 0x18 and decide
#       from that; set it when flashing with no input board attached, because
#       then there is nothing to probe.
#
#   BONEIO_FLASHER_STATION=1
#       Factory test station. Instead of halting when the flash is done, the
#       board boots systemd from the SD CARD (not from the eMMC it just wrote)
#       with the tester configuration, so black-tester can drive it over USB at
#       192.168.7.2. Anything else, including unset, means halt and wait for
#       the card to be pulled.
#
#   BONEIO_STATION_PASSWORD=Black
#       Station mode only. The password black-tester uses over SSH to read the
#       board serial. The shipped image locks the account on purpose, so no
#       password works at all, and station mode sets this one on the SD card.
#       Only ever touches the SD card. Set it empty to leave the account
#       locked and give up the serial read.
#
#   BONEIO_EMMC_PASSWORD=<password>
#       Sets a working password for the boneio account on the eMMC that was
#       just flashed. Off by default, and off is the right answer for anything
#       that leaves the building: the image deliberately ships the account
#       locked, so the owner's first password from the first-run wizard
#       becomes it. Set it only for boards that stay on the bench.
#
#       The two password settings differ by which disk they touch, which is
#       the only thing worth remembering about them:
#         BONEIO_STATION_PASSWORD  → the SD card you booted from
#         BONEIO_EMMC_PASSWORD     → the eMMC you just wrote
#
#       Neither helps an image built by setup_boneio.sh and booted straight
#       from a card; that one takes BONEIO_USER_PASSWORD at build time.
#
#   BONEIO_RESET_ACCOUNTS=1
#       Locked out: forgot the panel password, which the first-run wizard made
#       the SSH one too. Does NOT write the image. Moves the panel accounts
#       aside (users.json -> users.json.reset-<time>), locks the boneio login
#       as a new image ships it, and halts. Boot without the card and the
#       wizard runs again; configuration, secrets, MQTT accounts, Node-RED
#       and certificates all stay. With BONEIO_EMMC_PASSWORD set, that
#       password goes on the boneio login instead of the lock.
#
#   BONEIO_COLLECT_LOGS=1
#       A controller that does not boot. Nothing on the eMMC is changed: the
#       journal (log2ram's copy, plus anything written before log2ram
#       mounted), a read-only fsck of both partitions, half-installed
#       packages, applied migrations, uEnv.txt, this boot's dmesg and the
#       configuration without secrets.yaml go to boneio-logs-<time>/ on the
#       SD card's FAT partition, readable on any PC. Then it halts — or, with
#       a reset or reinstall also set, carries on with that.
#
#   BONEIO_KEEP_CONFIG=1
#       Reflash, keeping the configuration: /home/boneio/boneio (every YAML
#       file, secrets.yaml, state), the Node-RED flows and the MQTT broker
#       accounts are copied off the old eMMC first and put back on the new
#       system, so Home Assistant keeps connecting. The panel accounts are
#       not kept — the wizard runs again. If the old system cannot be read,
#       nothing is written.
#
# Run with --help to print this.
#

case "${1:-}" in
	-h|--help|help)
		sed -n '2,/^$/p' "$0" | sed 's/^#\{0,1\} \{0,1\}//'
		exit 0
		;;
esac

if ! id | grep -q root; then
	echo "must be run as root:"
	exit
fi

version_message="3.1.0, dd-based flasher - reads /boneio-emmc.img from root filesystem..."

# Configuration
IMAGE_FILE="/boneio-emmc.img"
DESTINATION="/dev/mmcblk1"
OLED_SCRIPT="/usr/sbin/oled_msg.sh"

# Display message on OLED (safe to call without OLED connected)
# When daemon is running (--serve), messages go via FIFO — instant, no flicker.
oled_msg() {
	if [ -x "${OLED_SCRIPT}" ]; then
		${OLED_SCRIPT} "$@" &
	fi
}

# Start OLED daemon (keeps Python+luma in memory for flicker-free updates)
oled_start_daemon() {
	if [ -x "${OLED_SCRIPT}" ]; then
		${OLED_SCRIPT} --serve
	fi
}

# Stop OLED daemon
oled_stop_daemon() {
	if [ -x "${OLED_SCRIPT}" ]; then
		${OLED_SCRIPT} --stop
	fi
}

cylon_leds() {
	local leds_base=/sys/class/leds/beaglebone\:green\:usr
	if [ -e ${leds_base}0/trigger ] ; then
		echo none > ${leds_base}0/trigger || true
		echo none > ${leds_base}1/trigger || true
		echo none > ${leds_base}2/trigger || true
		echo none > ${leds_base}3/trigger || true

		STATE=1
		while : ; do
		case $STATE in
			1)
				echo 1 > ${leds_base}0/brightness || true
				echo 0 > ${leds_base}1/brightness || true
				echo 0 > ${leds_base}2/brightness || true
				echo 0 > ${leds_base}3/brightness || true
				STATE=2
				;;
			2)
				echo 0 > ${leds_base}0/brightness || true
				echo 1 > ${leds_base}1/brightness || true
				echo 0 > ${leds_base}2/brightness || true
				echo 0 > ${leds_base}3/brightness || true
				STATE=3
				;;
			3)
				echo 0 > ${leds_base}0/brightness || true
				echo 0 > ${leds_base}1/brightness || true
				echo 1 > ${leds_base}2/brightness || true
				echo 0 > ${leds_base}3/brightness || true
				STATE=4
				;;
			4)
				echo 0 > ${leds_base}0/brightness || true
				echo 0 > ${leds_base}1/brightness || true
				echo 0 > ${leds_base}2/brightness || true
				echo 1 > ${leds_base}3/brightness || true
				STATE=5
				;;
			5)
				echo 0 > ${leds_base}0/brightness || true
				echo 0 > ${leds_base}1/brightness || true
				echo 1 > ${leds_base}2/brightness || true
				echo 0 > ${leds_base}3/brightness || true
				STATE=6
				;;
			6)
				echo 0 > ${leds_base}0/brightness || true
				echo 1 > ${leds_base}1/brightness || true
				echo 0 > ${leds_base}2/brightness || true
				echo 0 > ${leds_base}3/brightness || true
				STATE=1
				;;
			*)
				STATE=1
				;;
		esac
		sleep 0.1
		done
	fi
}

all_leds_on() {
	local leds_base=/sys/class/leds/beaglebone\:green\:usr
	if [ -e ${leds_base}0/trigger ] ; then
		echo 1 > ${leds_base}0/brightness || true
		echo 1 > ${leds_base}1/brightness || true
		echo 1 > ${leds_base}2/brightness || true
		echo 1 > ${leds_base}3/brightness || true
	fi
}

broadcast () {
	if [ "x${message}" != "x" ] ; then
		echo "${message}"
	fi
}

stabilize_system () {
	message="INFO: Giving system time to stabilize..." ; broadcast

	# Mount essential pseudo-filesystems (needed when running as init)
	if [ ! -e /proc/cmdline ] ; then
		message="INFO: Mounting /proc" ; broadcast
		mount -t proc proc /proc
	fi
	if [ ! -e /sys/class ] ; then
		message="INFO: Mounting /sys" ; broadcast
		mount -t sysfs sysfs /sys
	fi
	if [ ! -e /dev/mmcblk0 ] ; then
		message="INFO: Mounting /dev" ; broadcast
		mount -t devtmpfs devtmpfs /dev
	fi

	message="INFO: Preparing /tmp" ; broadcast
	mount -t tmpfs tmpfs /tmp 2>/dev/null || true

	if [ -f /proc/sys/vm/min_free_kbytes ] ; then
		message="INFO: [sysctl -w vm.min_free_kbytes=16384]" ; broadcast
		sysctl -w vm.min_free_kbytes=16384 || true
	fi

	# Load I2C module for OLED display
	modprobe i2c-dev 2>/dev/null || true

	# Silence buzzer on v1.0 boards (P9_12 = gpio1[28] = GPIO 60)
	# The default overlay (v0.4-v0.8) configures P9_12 as w1-gpio with pullup,
	# which causes the buzzer to sound on v1.0 hardware. Force it LOW immediately.
	if [ -d /sys/class/gpio ]; then
		echo 60 > /sys/class/gpio/export 2>/dev/null || true
		if [ -d /sys/class/gpio/gpio60 ]; then
			echo out > /sys/class/gpio/gpio60/direction 2>/dev/null || true
			echo 0 > /sys/class/gpio/gpio60/value 2>/dev/null || true
			message="INFO: Silenced buzzer (GPIO 60 / P9_12 -> LOW)" ; broadcast
		fi
	fi

	# Start OLED daemon (keeps Python+luma in memory for flicker-free updates)
	oled_start_daemon

	# Load MMC/eMMC kernel modules (may be needed if not built-in)
	message="INFO: Loading MMC kernel modules..." ; broadcast
	modprobe mmc_block 2>/dev/null || true
	modprobe omap_hsmmc 2>/dev/null || true
	modprobe sdhci-omap 2>/dev/null || true

	sleep 3
	message="INFO: System stabilized" ; broadcast
	message="--------------------------------------------------------------------------------" ; broadcast
}

# Progress monitor - polls /proc/PID/io for write_bytes and updates OLED
# Uses oled_msg (proven to work in flasher context) every 10s
progress_monitor() {
	local total_bytes="$1"
	local dd_pid="$2"
	local start_time=$(date +%s)

	oled_msg "Flashing eMMC" "[----------] 0%" "Starting..."

	while [ -e "/proc/${dd_pid}" ]; do
		sleep 10

		# Read write_bytes from /proc/PID/io
		local written=0
		if [ -f "/proc/${dd_pid}/io" ]; then
			written=$(grep '^write_bytes:' /proc/${dd_pid}/io 2>/dev/null | awk '{print $2}' || echo 0)
		fi
		[ -z "$written" ] && written=0

		local elapsed=$(( $(date +%s) - start_time ))
		local mins=$(( elapsed / 60 ))
		local secs=$(( elapsed % 60 ))
		local pct=0
		if [ "$total_bytes" -gt 0 ] 2>/dev/null; then
			pct=$(( written * 100 / total_bytes ))
			[ "$pct" -gt 100 ] && pct=100
		fi

		# Build progress bar
		local filled=$(( pct / 10 ))
		local empty=$(( 10 - filled ))
		local bar=""
		local i
		for i in $(seq 1 $filled); do bar="${bar}="; done
		for i in $(seq 1 $empty); do bar="${bar}-"; done

		oled_msg "Flashing eMMC" "[${bar}] ${pct}%" "${mins}m ${secs}s"
		echo "INFO: Progress: ${pct}% (${mins}m ${secs}s elapsed)"
	done
}

stop_progress_monitor() {
	if [ -n "$PROGRESS_PID" ] && [ -e /proc/$PROGRESS_PID ]; then
		kill $PROGRESS_PID > /dev/null 2>&1 || true
	fi
	PROGRESS_PID=""
}

write_failure () {
	message="ERROR: writing to [${DESTINATION}] failed..." ; broadcast
	stop_progress_monitor

	if [ "x${has_usr_leds}" = "xenable" ] ; then
		if [ -n "$CYLON_PID" ]; then
			kill $CYLON_PID > /dev/null 2>&1 || true
		fi
		# Blink all LEDs as error indicator
		leds_base=/sys/class/leds/beaglebone\:green\:usr
		while : ; do
			echo 1 > ${leds_base}0/brightness || true
			echo 1 > ${leds_base}1/brightness || true
			echo 1 > ${leds_base}2/brightness || true
			echo 1 > ${leds_base}3/brightness || true
			sleep 0.5
			echo 0 > ${leds_base}0/brightness || true
			echo 0 > ${leds_base}1/brightness || true
			echo 0 > ${leds_base}2/brightness || true
			echo 0 > ${leds_base}3/brightness || true
			sleep 0.5
		done
	fi
	exit 1
}

startup_checks () {
	message="INFO: ===============================================" ; broadcast
	message="INFO: DD-based eMMC flasher ${version_message}" ; broadcast
	message="INFO: ===============================================" ; broadcast
	message="INFO: Image file: ${IMAGE_FILE}" ; broadcast
	message="INFO: ===============================================" ; broadcast

	has_usr_leds="enable"

	if [ "x${has_usr_leds}" = "xenable" ] ; then
		cylon_leds & CYLON_PID=$!
	fi

	# Wait for eMMC device to appear (may take a few seconds at boot)
	message="INFO: Waiting for eMMC device..." ; broadcast
	WAIT_COUNT=0
	while [ ! -b "${DESTINATION}" ] && [ $WAIT_COUNT -lt 30 ]; do
		sleep 1
		WAIT_COUNT=$((WAIT_COUNT + 1))
		echo "INFO: Waiting for ${DESTINATION}... (${WAIT_COUNT}s)"
	done

	# Check destination exists
	if [ ! -b "${DESTINATION}" ] ; then
		message="ERROR: [${DESTINATION}] does not exist" ; broadcast
		message="INFO: Available block devices:" ; broadcast
		ls -la /dev/mmcblk* /dev/sd* 2>/dev/null || true
		lsblk 2>/dev/null || true
		write_failure
	fi
	message="INFO: Destination [${DESTINATION}] OK" ; broadcast
}

find_image_file () {
	message="INFO: Looking for image file..." ; broadcast

	if [ -f "${IMAGE_FILE}" ] ; then
		IMAGE_SIZE=$(stat -c%s "${IMAGE_FILE}")
		message="INFO: Found image: ${IMAGE_FILE} ($(numfmt --to=iec ${IMAGE_SIZE}))" ; broadcast
	else
		message="ERROR: Image file not found: ${IMAGE_FILE}" ; broadcast
		message="INFO: Available files in /:" ; broadcast
		ls -la /*.img 2>/dev/null || echo "No .img files found"
		write_failure
	fi
	message="--------------------------------------------------------------------------------" ; broadcast
}

flash_emmc () {
	message="INFO: Flashing eMMC..." ; broadcast

	message="INFO: [dd if=${IMAGE_FILE} of=${DESTINATION} bs=4M]" ; broadcast
	message="--------------------------------------------------------------------------------" ; broadcast

	# Run dd in background so we can monitor progress
	dd if="${IMAGE_FILE}" of="${DESTINATION}" bs=4M 2>/dev/null &
	local DD_PID=$!

	# Start OLED progress monitor (polls /proc/$DD_PID/io every 10s)
	progress_monitor "${IMAGE_SIZE}" "${DD_PID}" &
	PROGRESS_PID=$!

	# Wait for dd to finish
	wait $DD_PID || write_failure

	# Stop progress monitor
	stop_progress_monitor

	message="--------------------------------------------------------------------------------" ; broadcast
	message="INFO: Write complete, syncing..." ; broadcast
	sync
	blockdev --flushbufs ${DESTINATION} || true

	message="INFO: Forcing eMMC readback to flush write cache..." ; broadcast
	dd if=${DESTINATION} of=/dev/null bs=4M count=100 status=progress || true
	sync

	message="--------------------------------------------------------------------------------" ; broadcast
	message="INFO: Flash complete!" ; broadcast
}

fix_emmc_rootfs () {
	message="INFO: Fixing eMMC rootfs configuration..." ; broadcast
	oled_msg "Setup system" "[----------] 0%" "Scanning..."

	# Re-read partition table after dd
	message="INFO: Re-reading partition table on ${DESTINATION}..." ; broadcast
	partprobe ${DESTINATION} 2>/dev/null || true
	blockdev --rereadpt ${DESTINATION} 2>/dev/null || true
	sleep 2

	# Find ext4 partition on eMMC (rootfs)
	EMMC_ROOTFS=""
	media_rootfs=""
	for i in 1 2 3; do
		if [ -b "${DESTINATION}p${i}" ]; then
			PART="${DESTINATION}p${i}"
		elif [ -b "${DESTINATION}${i}" ]; then
			PART="${DESTINATION}${i}"
		else
			continue
		fi

		FS_TYPE=$(blkid -s TYPE -o value "$PART" 2>/dev/null || echo "unknown")
		if [ "$FS_TYPE" = "ext4" ]; then
			EMMC_ROOTFS="$PART"
			media_rootfs="$i"
			break
		fi
	done

	if [ -z "$EMMC_ROOTFS" ]; then
		message="WARNING: Could not find eMMC rootfs partition, skipping fstab fix" ; broadcast
		return
	fi

	message="INFO: Found eMMC rootfs: ${EMMC_ROOTFS} (partition ${media_rootfs})" ; broadcast

	# Expand rootfs partition to fill entire eMMC
	message="INFO: Expanding partition ${media_rootfs} on ${DESTINATION}..." ; broadcast
	oled_msg "Setup system" "[==---------] 15%" "Expanding partition"
	if command -v growpart >/dev/null 2>&1; then
		oled_msg "Setup system" "[===--------] 16%" "Growpart"
		growpart ${DESTINATION} ${media_rootfs} || true
		message="INFO: growpart done" ; broadcast
	else
		oled_msg "Setup system" "[===--------] 16%" "Sfdisk"
		message="INFO: growpart not available, using sfdisk..." ; broadcast
		echo ", +" | sfdisk -N ${media_rootfs} ${DESTINATION} --force 2>/dev/null || true
	fi
	# Ensure kernel sees updated partition table before resize
	partprobe ${DESTINATION} 2>/dev/null || true
	blockdev --rereadpt ${DESTINATION} 2>/dev/null || true
	udevadm settle --timeout=5 2>/dev/null || true
	sleep 3

	# Log partition size so we can verify growpart worked
	PART_SIZE_SECTORS=$(cat /sys/class/block/$(basename ${EMMC_ROOTFS})/size 2>/dev/null || echo "?")
	message="INFO: Partition ${EMMC_ROOTFS} size: ${PART_SIZE_SECTORS} sectors" ; broadcast

	# Resize ext4 filesystem to fill expanded partition
	message="INFO: Resizing filesystem on ${EMMC_ROOTFS}..." ; broadcast
	oled_msg "Setup system" "[===--------] 30%" "Resizing filesystem"
	message="INFO: Running e2fsck on ${EMMC_ROOTFS}..." ; broadcast
	# e2fsck exit codes: 0=clean, 1=errors corrected (OK), 2+=problem
	e2fsck -f -y ${EMMC_ROOTFS}
	E2FSCK_RC=$?
	if [ $E2FSCK_RC -gt 1 ]; then
		message="WARNING: e2fsck returned $E2FSCK_RC" ; broadcast
	else
		message="INFO: e2fsck OK (rc=$E2FSCK_RC)" ; broadcast
	fi
	message="INFO: Running resize2fs on ${EMMC_ROOTFS}..." ; broadcast
	RESIZE_OK=false
	if resize2fs ${EMMC_ROOTFS}; then
		message="INFO: resize2fs succeeded" ; broadcast
		RESIZE_OK=true
	else
		# Retry 1: e2fsck + resize2fs
		message="WARNING: resize2fs failed, retrying after e2fsck..." ; broadcast
		e2fsck -f -y ${EMMC_ROOTFS} 2>/dev/null
		if resize2fs ${EMMC_ROOTFS} 2>/dev/null; then
			message="INFO: resize2fs succeeded on retry 1" ; broadcast
			RESIZE_OK=true
		else
			# Retry 2: full partition table re-read + longer settle + retry
			message="WARNING: resize2fs retry 1 failed, forcing partition re-read..." ; broadcast
			blockdev --rereadpt ${DESTINATION} 2>/dev/null || true
			partprobe ${DESTINATION} 2>/dev/null || true
			udevadm settle --timeout=10 2>/dev/null || true
			sleep 3
			e2fsck -f -y ${EMMC_ROOTFS} 2>/dev/null
			if resize2fs ${EMMC_ROOTFS} 2>/dev/null; then
				message="INFO: resize2fs succeeded on retry 2" ; broadcast
				RESIZE_OK=true
			else
				message="WARNING: resize2fs failed! Will add first-boot fallback." ; broadcast
				oled_msg "Setup system" "[===--------] 30%" "Resize deferred"
				sleep 2
			fi
		fi
	fi
	# Verify new size
	NEW_BLOCKS=$(dumpe2fs -h ${EMMC_ROOTFS} 2>/dev/null | grep 'Block count' | awk '{print $3}')
	NEW_BLOCK_SIZE=$(dumpe2fs -h ${EMMC_ROOTFS} 2>/dev/null | grep 'Block size' | awk '{print $3}')
	if [ -n "$NEW_BLOCKS" ] && [ -n "$NEW_BLOCK_SIZE" ]; then
		NEW_SIZE_MB=$(( NEW_BLOCKS * NEW_BLOCK_SIZE / 1024 / 1024 ))
		message="INFO: Filesystem size after resize: ${NEW_SIZE_MB} MB" ; broadcast
	fi
	message="INFO: Filesystem resize complete" ; broadcast

	mkdir -p /tmp/rootfs/ || true
	if ! mount "${EMMC_ROOTFS}" /tmp/rootfs/ -o async,noatime 2>/dev/null; then
		message="WARNING: Could not mount eMMC rootfs" ; broadcast
		return
	fi

	# Generate /etc/fstab with correct eMMC device paths
	message="INFO: Generating: /etc/fstab" ; broadcast
	oled_msg "Setup system" "[=====------] 45%" "Configuring fstab"
	echo "# /etc/fstab: static file system information." > /tmp/rootfs/etc/fstab
	echo "#" >> /tmp/rootfs/etc/fstab
	echo "${DESTINATION}p${media_rootfs}  /  ext4  noatime,errors=remount-ro  0  1" >> /tmp/rootfs/etc/fstab

	# nofail on the FAT partition: nothing the boot needs lives there (U-Boot
	# reads uEnv.txt and the kernel from the ext4 root), and FAT has no journal.
	# Without it, a partition torn by a power cut sends systemd to emergency
	# mode with a healthy root. Migration 1.6.24 does the same on installed units.
	if [ "x${media_rootfs}" = "x2" ] ; then
		echo "${DESTINATION}p1  /boot/firmware vfat user,uid=1000,gid=1000,defaults,nofail 0 2" >> /tmp/rootfs/etc/fstab
	fi

	if [ "x${media_rootfs}" = "x3" ] ; then
		echo "${DESTINATION}p1  /boot/firmware vfat user,uid=1000,gid=1000,defaults,nofail 0 2" >> /tmp/rootfs/etc/fstab
		echo "${DESTINATION}p2       none    swap    sw      0       0" >> /tmp/rootfs/etc/fstab
	fi

	echo "debugfs  /sys/kernel/debug  debugfs  mode=755,uid=root,gid=gpio,defaults  0  0" >> /tmp/rootfs/etc/fstab
	message="INFO: [cat /tmp/rootfs/etc/fstab]" ; broadcast
	cat /tmp/rootfs/etc/fstab
	message="--------------------------------------------------------------------------------" ; broadcast

	# Disable flasher cmdline in eMMC uEnv.txt
	oled_msg "Setup system" "[======-----] 60%" "Fixing boot config"
	if [ -f /tmp/rootfs/boot/uEnv.txt ]; then
		sed -i -e 's:cmdline=init:#cmdline=init:g' /tmp/rootfs/boot/uEnv.txt
		message="INFO: Disabled flasher cmdline in eMMC uEnv.txt" ; broadcast
	fi

	# =========================================================================
	# Detect board version
	# Priority:
	#   1. /boot/firmware/boneio.txt (user override on SD boot partition)
	#   2. I2C probe: DS2484 at 0x18 on I2C2 = board v1.0+
	#
	# The probe can only tell a 1.x board from a 0.x one — 1.0 and 1.1 are
	# electrically identical apart from the buzzer, which is not on I2C. Boards
	# coming off the line now are 1.1, so that is what an auto-detected board is
	# stamped with; put BOARD_VERSION in boneio.txt to flash an older 1.0.
	#
	# boneio.txt format (FAT32 boot partition, editable from any PC):
	#   BOARD_VERSION=1.1
	# =========================================================================
	oled_msg "Setup system" "[======-----] 62%" "Detecting board"

	BOARD_VERSION=""
	BOARD_HAS_DS2484=false
	# Version stamped on a board identified by the I2C probe alone.
	DETECTED_V1_VERSION="1.1"

	# 1. Check for boneio.txt override on SD boot partition
	#    When running as init (PID 1), /boot/firmware is NOT mounted yet.
	#    Mount the SD card's FAT32 boot partition temporarily.
	BONEIO_TXT=""
	BOOT_MOUNTED=false
	if ! mountpoint -q /boot/firmware 2>/dev/null; then
		mkdir -p /boot/firmware
		if mount /dev/mmcblk0p1 /boot/firmware -o ro 2>/dev/null; then
			BOOT_MOUNTED=true
			message="INFO: Mounted SD boot partition at /boot/firmware" ; broadcast
		fi
	fi

	for candidate in /boot/firmware/boneio.txt /boot/boneio.txt; do
		if [ -f "$candidate" ]; then
			BONEIO_TXT="$candidate"
			break
		fi
	done

	if [ -n "$BONEIO_TXT" ]; then
		# Source the file to get BOARD_VERSION variable
		. "$BONEIO_TXT"
		if [ -n "$BOARD_VERSION" ]; then
			message="INFO: Found boneio.txt -> BOARD_VERSION=${BOARD_VERSION}" ; broadcast
			case "$BOARD_VERSION" in
				1.0|1.0.*|1.1|1.1.*)
					BOARD_HAS_DS2484=true
					message="INFO: Board version ${BOARD_VERSION} -> using v1.0 overlay, config stamped ${BOARD_VERSION}" ; broadcast
					;;
				0.4|0.5|0.6|0.7|0.8|0.8.*)
					BOARD_HAS_DS2484=false
					message="INFO: Board version ${BOARD_VERSION} -> using default overlay" ; broadcast
					;;
				*)
					message="WARNING: Unknown BOARD_VERSION=${BOARD_VERSION} in boneio.txt, falling back to I2C probe" ; broadcast
					BOARD_VERSION=""
					;;
			esac
		else
			message="INFO: boneio.txt found but BOARD_VERSION not set, falling back to I2C probe" ; broadcast
		fi
	fi

	# Unmount boot partition if we mounted it
	if $BOOT_MOUNTED; then
		umount /boot/firmware 2>/dev/null || true
	fi

	# 2. Fall back to I2C auto-detection if no valid boneio.txt
	if [ -z "$BOARD_VERSION" ]; then
		message="INFO: Probing I2C2 for DS2484 (0x18)..." ; broadcast

		# Ensure I2C bus is available
		modprobe i2c-dev 2>/dev/null || true
		sleep 1

		# Diagnostic: list available I2C buses
		I2C_BUSES=$(ls /dev/i2c-* 2>/dev/null || echo "none")
		message="DIAG: Available I2C buses: ${I2C_BUSES}" ; broadcast

		if command -v i2cdetect >/dev/null 2>&1; then
			message="DIAG: i2cdetect found at $(command -v i2cdetect)" ; broadcast
			# Dump full i2cdetect output for debugging
			I2C_SCAN=$(i2cdetect -y -r 2 0x18 0x18 2>&1 || echo "FAILED")
			message="DIAG: i2cdetect output: ${I2C_SCAN}" ; broadcast

			# Probe address 0x18 on I2C bus 2 (quick mode, single address)
			if echo "$I2C_SCAN" | grep -q "18"; then
				BOARD_HAS_DS2484=true
				BOARD_VERSION="$DETECTED_V1_VERSION"
				message="INFO: DS2484 detected at 0x18 on I2C2 -> board v1.x, stamping ${BOARD_VERSION}" ; broadcast
			else
				message="INFO: No DS2484 at 0x18 -> board v0.4-v0.8 (GPIO 1-Wire)" ; broadcast
			fi
		elif [ -e /dev/i2c-2 ]; then
			message="DIAG: No i2cdetect, trying raw Python probe on /dev/i2c-2" ; broadcast
			# Fallback: raw I2C probe without i2cdetect
			# Try reading from address 0x18 - if device is present, read succeeds
			if python3 -c "
import struct, fcntl, os
I2C_SLAVE = 0x0703
fd = os.open('/dev/i2c-2', os.O_RDWR)
fcntl.ioctl(fd, I2C_SLAVE, 0x18)
try:
    os.read(fd, 1)
    print('found')
except:
    print('none')
finally:
    os.close(fd)
" 2>/dev/null | grep -q "found"; then
				BOARD_HAS_DS2484=true
				BOARD_VERSION="$DETECTED_V1_VERSION"
				message="INFO: DS2484 detected (raw probe) -> board v1.x, stamping ${BOARD_VERSION}" ; broadcast
			else
				message="INFO: No DS2484 (raw probe) -> board v0.4-v0.8" ; broadcast
			fi
		else
			message="WARNING: Cannot probe I2C2 (no i2cdetect, no /dev/i2c-2). Using default overlay." ; broadcast
		fi
	fi

	# Select overlay based on board detection
	UENV_FILE=""
	if [ -f /tmp/rootfs/boot/firmware/uEnv.txt ]; then
		UENV_FILE="/tmp/rootfs/boot/firmware/uEnv.txt"
	elif [ -f /tmp/rootfs/boot/uEnv.txt ]; then
		UENV_FILE="/tmp/rootfs/boot/uEnv.txt"
	fi

	if [ -n "$UENV_FILE" ] && [ "$BOARD_HAS_DS2484" = true ]; then
		message="INFO: Switching overlay to BONEIO-BLACK-PINS-v1.0.dtbo" ; broadcast
		oled_msg "Setup system" "[======-----] 64%" "Board v1.0 overlay"
		# Replace any existing BONEIO-BLACK-PINS overlay reference
		sed -i \
			-e 's|uboot_overlay_addr0=.*BONEIO-BLACK-PINS[^ ]*|uboot_overlay_addr0=BONEIO-BLACK-PINS-v1.0.dtbo|' \
			"$UENV_FILE"
		message="INFO: Overlay set to BONEIO-BLACK-PINS-v1.0.dtbo" ; broadcast

		# Install 1-Wire kernel modules config (ds2482 + w1-therm)
		# This ensures modules are loaded at boot without waiting for boneio-migrate
		ONEWIRE_CONF="/tmp/rootfs/etc/modules-load.d/onewire.conf"
		if [ ! -f "$ONEWIRE_CONF" ]; then
			mkdir -p /tmp/rootfs/etc/modules-load.d
			printf 'ds2482\nw1-therm\n' > "$ONEWIRE_CONF"
			message="INFO: Installed onewire.conf (ds2482 + w1-therm modules)" ; broadcast
		else
			message="INFO: onewire.conf already exists, skipping" ; broadcast
		fi

		# Stamp the detected board version into config.yaml. The shipped image
		# carries 0.8; a re-flashed 1.0 board gets bumped to whatever this run
		# detected, so the config always matches the board in hand.
		TARGET_VERSION="${BOARD_VERSION:-$DETECTED_V1_VERSION}"
		BONEIO_CONFIG="/tmp/rootfs/home/boneio/boneio/config.yaml"
		if [ -f "$BONEIO_CONFIG" ]; then
			# Only the version: inside the boneio: section. Other sections carry
			# their own version keys (a modbus device, for one), and stamping
			# those would quietly corrupt the config. The sed range runs from
			# "boneio:" to the next top-level key; busybox sed has no \s, hence
			# the POSIX classes.
			BONEIO_SECTION='/^boneio:/,/^[^[:space:]#]/'
			OLD_VER=$(sed -n "${BONEIO_SECTION} s/^[[:space:]]*version:[[:space:]]*\([0-9.]*\).*/\1/p" "$BONEIO_CONFIG" | head -n 1)
			if [ -z "$OLD_VER" ]; then
				message="WARNING: No board version in config.yaml boneio section, leaving it alone" ; broadcast
			elif [ "$OLD_VER" = "$TARGET_VERSION" ]; then
				message="INFO: config.yaml board version already ${TARGET_VERSION}" ; broadcast
			else
				sed -i "${BONEIO_SECTION} s/^\([[:space:]]*version:[[:space:]]*\)[0-9.]*/\1${TARGET_VERSION}/" "$BONEIO_CONFIG"
				message="INFO: Updated config.yaml board version ${OLD_VER} -> ${TARGET_VERSION}" ; broadcast
			fi
			# Remove deprecated ds2482 section (kernel handles 1-Wire now)
			if grep -q '^ds2482:' "$BONEIO_CONFIG"; then
				sed -i '/^ds2482:/,/^[^ ]/{ /^ds2482:/d; /^  /d; }' "$BONEIO_CONFIG"
				message="INFO: Removed deprecated ds2482 section from config.yaml" ; broadcast
			fi
			# Replace ina219 with ina226 (v1.0 uses INA226 power monitor)
			if grep -q '^ina219:' "$BONEIO_CONFIG"; then
				sed -i 's/^ina219:/ina226:/' "$BONEIO_CONFIG"
				message="INFO: Updated config.yaml ina219 -> ina226 for v1.0 board" ; broadcast
			fi
		fi

		# Detect relay board active-LOW (inverted) logic
		# MCP23017 at address 0x23 (35), register 0x12 (GPIOA)
		# Reading GPIOA while pins are in INPUT mode (power-on reset default):
		# If GPIOA reads 0xFF, the relay board has pull-ups -> active-LOW logic (inverted = true)
		RELAY_INVERTED=false
		if command -v i2cget >/dev/null 2>&1; then
			GPIO_A=$(i2cget -y 2 0x23 0x12 2>/dev/null || echo "0x00")
			if [ "$GPIO_A" = "0xff" ]; then
				RELAY_INVERTED=true
				message="INFO: Relay board detected as active-LOW (inverted)" ; broadcast
			fi
		elif python3 -c "
import fcntl, os
I2C_SLAVE = 0x0703
try:
    fd = os.open('/dev/i2c-2', os.O_RDWR)
    fcntl.ioctl(fd, I2C_SLAVE, 0x23)
    os.write(fd, b'\x12')
    data = os.read(fd, 1)
    if data == b'\xff':
        print('inverted')
    os.close(fd)
except:
    pass
" 2>/dev/null | grep -q "inverted"; then
			RELAY_INVERTED=true
			message="INFO: Relay board detected as active-LOW (inverted, raw probe)" ; broadcast
		fi

		if [ "$RELAY_INVERTED" = true ]; then
			STATE_FILE="/tmp/rootfs/home/boneio/boneiostate.json"
			mkdir -p /tmp/rootfs/home/boneio
			python3 -c "
import json, os
state_file = '$STATE_FILE'
state = {}
if os.path.exists(state_file):
    try:
        with open(state_file) as f:
            state = json.load(f)
    except:
        state = {}
state.setdefault('hardware', {})
state['hardware']['mcp_0x23_inverted'] = True
state['hardware']['mcp_0x24_inverted'] = True
state['hardware']['mcp_0x25_inverted'] = True
with open(state_file, 'w') as f:
    json.dump(state, f, indent=2)
"
			chown 1000:1000 "$STATE_FILE" 2>/dev/null || true
			message="INFO: Pre-seeded boneiostate.json with inverted relay board flag" ; broadcast
		fi
	elif [ -n "$UENV_FILE" ]; then
		message="INFO: Keeping default overlay (BONEIO-BLACK-PINS.dtbo)" ; broadcast
	fi

	# Update generic-sys-mods if present
	if [ -f /tmp/rootfs/etc/default/generic-sys-mods ] ; then
		. /tmp/rootfs/etc/default/generic-sys-mods
		echo "#This file is sourced by /usr/bin/bb-growpart" > /tmp/rootfs/etc/default/generic-sys-mods
		echo "ROOT_DRIVE=${DESTINATION}" >> /tmp/rootfs/etc/default/generic-sys-mods
		echo "ROOT_PARTITION=${ROOT_PARTITION}" >> /tmp/rootfs/etc/default/generic-sys-mods
		echo "ARCH_SOC_MODULES=${ARCH_SOC_MODULES}" >> /tmp/rootfs/etc/default/generic-sys-mods
		message="INFO: Updated generic-sys-mods" ; broadcast
	fi

	# Remove pishrink resize2fs_once (references wrong device from SD image)
	if [ -f /tmp/rootfs/etc/init.d/resize2fs_once ] ; then
		rm -f /tmp/rootfs/etc/init.d/resize2fs_once || true
		rm -f /tmp/rootfs/etc/rc2.d/*resize2fs_once 2>/dev/null || true
		rm -f /tmp/rootfs/etc/rc3.d/*resize2fs_once 2>/dev/null || true
		rm -f /tmp/rootfs/etc/rc5.d/*resize2fs_once 2>/dev/null || true
		message="INFO: Removed resize2fs_once (not needed, partition already expanded)" ; broadcast
	fi

	# Remove grow_partition service (references wrong device from SD image)
	if [ -f /tmp/rootfs/etc/systemd/system/multi-user.target.wants/grow_partition.service ] ; then
		rm -f /tmp/rootfs/etc/systemd/system/multi-user.target.wants/grow_partition.service || true
		message="INFO: Removed grow_partition.service" ; broadcast
	fi

	# Generate SSH host keys (so bbbio-set-sysconf doesn't need to reboot)
	# NOTE: Flasher runs as init with minimal entropy. We seed the pool
	# from hardware sources and skip RSA (slow prime generation).
	message="INFO: Seeding entropy for SSH keygen..." ; broadcast
	oled_msg "Setup system" "[========---] 75%" "Generating SSH keys"

	# Seed entropy from hardware RNG (AM335x has built-in TRNG)
	modprobe omap-rng 2>/dev/null || true
	if [ -c /dev/hwrng ]; then
		dd if=/dev/hwrng of=/dev/urandom count=1 bs=4096 2>/dev/null || true
		message="INFO: Seeded entropy from hardware RNG" ; broadcast
	else
		message="INFO: /dev/hwrng not available, using software entropy" ; broadcast
	fi
	# Fallback: also seed from system sources
	{
		cat /proc/interrupts
		cat /proc/timer_list 2>/dev/null
		cat /proc/cpuinfo
		date +%s%N
		cat /proc/device-tree/serial-number 2>/dev/null
		cat /sys/bus/i2c/devices/*/eeprom 2>/dev/null
	} > /dev/urandom 2>/dev/null || true

	# Remove old keys from rootfs image (they're shared across all devices)
	rm -f /tmp/rootfs/etc/ssh/ssh_host_*

	# Generate all key types (same as bbbio-set-sysconf)
	# With hwrng entropy, RSA keygen completes in ~5s on AM335x
	ssh-keygen -A -f /tmp/rootfs 2>/dev/null || true

	# Remove ssh_regenerate flag so bbbio-set-sysconf skips keygen + reboot
	rm -f /tmp/rootfs/etc/bbb.io/ssh_regenerate 2>/dev/null || true
	message="INFO: SSH host keys generated" ; broadcast

	# Write rc.local: if resize2fs failed in flasher, add first-boot fallback
	if [ "$RESIZE_OK" = true ]; then
		# Resize succeeded — clean rc.local
		cat > /tmp/rootfs/etc/rc.local <<'RCEOF'
#!/bin/sh -e
#
# rc.local - executed at the end of each multiuser runlevel
#
exit 0
RCEOF
		chmod +x /tmp/rootfs/etc/rc.local
		message="INFO: Cleaned rc.local (resize done in flasher)" ; broadcast
	else
		# Resize failed — add first-boot resize fallback
		cat > /tmp/rootfs/etc/rc.local <<RCEOF
#!/bin/sh -e
# First-boot filesystem resize (flasher resize2fs failed)
ROOTDEV="${EMMC_ROOTFS}"
if [ -b "\$ROOTDEV" ]; then
    logger -t rc.local "Resizing filesystem on \$ROOTDEV..."
    resize2fs \$ROOTDEV && logger -t rc.local "Filesystem resize complete"
fi
# Self-remove: only run once
cat > /etc/rc.local <<'EOF2'
#!/bin/sh -e
exit 0
EOF2
exit 0
RCEOF
		chmod +x /tmp/rootfs/etc/rc.local
		message="INFO: Added first-boot resize2fs fallback to rc.local" ; broadcast
	fi

	# Optional: a working password on the eMMC that was just written.
	#
	# Off by default, and off is right for anything that leaves the building.
	# The image locks this account on purpose (F-04): no password logs in until
	# the owner's first one, from the first-run wizard, is set. Setting this
	# gives that up for the flashed board, which is why it says so in the log.
	# chpasswd replaces the hash, so it clears the lock as well.
	if [ -n "${BONEIO_EMMC_PASSWORD:-}" ]; then
		if [ -f /tmp/rootfs/etc/shadow ]; then
			if chroot /tmp/rootfs /bin/sh -c \
				"echo 'boneio:${BONEIO_EMMC_PASSWORD}' | chpasswd" 2>/dev/null; then
				# Undo the expiry the image ships with, or the password is set
				# and still unusable without an interactive change.
				chroot /tmp/rootfs chage -d "$(( $(date +%s) / 86400 ))" boneio 2>/dev/null || true
				message="WARN: ===============================================" ; broadcast
				message="WARN: eMMC ships with a WORKING boneio password" ; broadcast
				message="WARN: BONEIO_EMMC_PASSWORD was set, so the account is" ; broadcast
				message="WARN: no longer locked. Bench boards only." ; broadcast
				message="WARN: ===============================================" ; broadcast
			else
				message="ERROR: Could not set the eMMC boneio password" ; broadcast
			fi
		else
			message="ERROR: No /etc/shadow on the eMMC rootfs; password not set" ; broadcast
		fi
	fi

	keep_config_restore

	oled_msg "Setup system" "[=========-] 90%" "Finishing up..."
	sync
	umount /tmp/rootfs/ || umount -l /tmp/rootfs/ || true
	message="INFO: eMMC rootfs configuration fixed" ; broadcast
	oled_msg "Setup system" "[==========] 100%" "Complete!"
	message="--------------------------------------------------------------------------------" ; broadcast
}

# Make the SD card system answer black-tester. Two things stop it by default,
# and both are deliberate everywhere except here.
station_prepare_sd_for_tester () {
	# 1. The account is shipped locked (passwd -l, see setup_boneio.sh). That
	#    is the right posture for a product — nobody can log in with a password
	#    until the owner's first one, from the first-run wizard, is set — but
	#    it also means black-tester, which reads the board serial over SSH, has
	#    nothing to log in with. Without this it reports no serial and the board
	#    cannot be matched to its test. chpasswd replaces the hash, which clears
	#    the lock too.
	#
	#    Only the SD card is touched. The eMMC that was just written keeps the
	#    locked account.
	if [ -n "${BONEIO_STATION_PASSWORD:-Black}" ]; then
		local station_pw="${BONEIO_STATION_PASSWORD:-Black}"
		if echo "boneio:${station_pw}" | chpasswd 2>/dev/null; then
			# chpasswd alone leaves the expiry date at 0, which still forces a
			# change at login. Both are needed.
			chage -d "$(( $(date +%s) / 86400 ))" boneio 2>/dev/null || true
			message="INFO: SD card boneio password re-armed for the tester" ; broadcast
		else
			message="WARN: Could not set the SD card boneio password; the tester will not read the serial" ; broadcast
		fi
	else
		message="INFO: BONEIO_STATION_PASSWORD empty — leaving the account locked" ; broadcast
	fi

	# 2. A device with no administrator account answers 403 "setup_required" to
	#    every API call, because the first-run wizard has not been through. A
	#    test station has nobody to walk it through, and the tester would see
	#    nothing but 403s — no hardware errors, no I2C scan, no relay switching,
	#    and so no reported fault, because it never reaches one.
	#
	#    So the flag is set here, at station boot, on the SD card's own config.
	#    Deliberately not in configs/tester/config.yaml: that directory is
	#    copied into ~/.cache/boneio_configs on every product image, and a file
	#    saying allow_anonymous sitting on every device in the field is a
	#    hazard waiting for the first feature that offers to restore a factory
	#    template. Nothing selects it today. That is not a reason to ship it.
	#
	#    The config cache keys on the file's SHA256, so editing it is enough —
	#    the cache re-validates by itself.
	local station_config="/home/boneio/boneio/config.yaml"
	if [ -f "$station_config" ]; then
		if grep -q "allow_anonymous" "$station_config"; then
			message="INFO: Tester config already allows anonymous API access" ; broadcast
		elif grep -q "^web:" "$station_config"; then
			sed -i "s/^web:/web:\n  auth:\n    allow_anonymous: true/" "$station_config"
			message="INFO: Enabled anonymous API access for the tester" ; broadcast
		else
			printf "\nweb:\n  auth:\n    allow_anonymous: true\n" >> "$station_config"
			message="INFO: Added web.auth.allow_anonymous for the tester" ; broadcast
		fi
	else
		message="WARN: No ${station_config} — the tester will get 403 from the API" ; broadcast
	fi
}

station_boot_or_shutdown () {
	if [ "${BONEIO_FLASHER_STATION}" = "1" ]; then
		message="INFO: ===============================================" ; broadcast
		message="INFO: STATION MODE — booting test system from SD card" ; broadcast
		message="INFO: ===============================================" ; broadcast

		local elapsed=$(( $(date +%s) - ${FLASH_START_TIME:-0} ))
		local mins=$(( elapsed / 60 ))
		local secs=$(( elapsed % 60 ))

		oled_msg "Station mode" "Flash: ${mins}m ${secs}s" "Preparing test..."

		# Remount SD card rootfs as read-write
		mount -o remount,rw / 2>/dev/null || true

		message="INFO: Tester config ready in /home/boneio/boneio" ; broadcast

		station_prepare_sd_for_tester

		# Generate SSH host keys for the SD card system if missing,
		# and remove ssh_regenerate / disable bbbio-set-sysconf so it NEVER triggers a reboot in station mode.
		if [ ! -f /etc/ssh/ssh_host_rsa_key ] && [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then
			message="INFO: Generating SSH keys for SD card station mode..." ; broadcast
			ssh-keygen -A 2>/dev/null || true
		fi
		rm -f /etc/bbb.io/ssh_regenerate 2>/dev/null || true
		rm -f /etc/systemd/system/multi-user.target.wants/bbbio-set-sysconf.service 2>/dev/null || true
		rm -f /lib/systemd/system/multi-user.target.wants/bbbio-set-sysconf.service 2>/dev/null || true

		# 2. Stop background processes
		oled_stop_daemon
		if [ -n "$CYLON_PID" ]; then
			kill $CYLON_PID > /dev/null 2>&1 || true
		fi

		all_leds_on

		oled_msg "Station mode" "Booting SD..." "Test system"
		message="INFO: Handing over to systemd on SD card..." ; broadcast
		sync

		# 3. Boot systemd from SD card — boneio.service will start with 32x10A test config.
		#    exec replaces PID 1, systemd takes over normally.
		exec /sbin/init

		# Should not reach here
		echo "ERROR: exec /sbin/init failed!" >&2
		halt -f
	else
		cleanup_and_shutdown
	fi
}

cleanup_and_shutdown () {
	message="INFO: Cleanup..." ; broadcast
	sync
	
	# Stop cylon animation
	if [ -n "$CYLON_PID" ]; then
		kill $CYLON_PID > /dev/null 2>&1 || true
	fi

	message="" ; broadcast
	# Calculate elapsed time
	local elapsed=$(( $(date +%s) - ${FLASH_START_TIME:-0} ))
	local mins=$(( elapsed / 60 ))
	local secs=$(( elapsed % 60 ))
	message="INFO: ===============================================" ; broadcast
	message="INFO: SUCCESS: eMMC flashed in ${mins}m ${secs}s!" ; broadcast
	message="INFO: ===============================================" ; broadcast
	message="INFO: Remove SD card and reboot" ; broadcast
	message="INFO: ===============================================" ; broadcast
	oled_msg "Flash complete!" "Done in ${mins}m ${secs}s" "Remove SD card"
	message="" ; broadcast

	# All LEDs on = success
	all_leds_on
	
	# Give user time to see success message
	sleep 10

	sync

	# Use halt instead of sysrq power-off.
	# sysrq 'o' (power off) shuts down GPIO modules, causing active-LOW buzzer
	# to sound. halt -f stops the CPU but keeps GPIO clocked and pins driven,
	# so the buzzer stays silent. User must physically remove power anyway.
	if [ -f /proc/sysrq-trigger ] ; then
		message="INFO: Syncing and halting..." ; broadcast
		echo s > /proc/sysrq-trigger
		sleep 1
	fi

	halt -f
}

# =============================================================================
# Recovery options — see BONEIO_RESET_ACCOUNTS and BONEIO_KEEP_CONFIG in the
# header. Both exist for an owner locked out of their own controller: the
# first-run wizard makes the panel password the SSH one too, so forgetting it
# leaves no way in, and reflashing used to take the configuration with it.
# Neither weakens anything: whoever holds an SD card and the power switch can
# already write anything they like to the eMMC.
# =============================================================================

OLD_ROOT="/tmp/oldroot"
KEEP_DIR="/tmp/boneio-keep"
# /tmp is a tmpfs, so the kept copy lives in RAM (512 MB on a BeagleBone).
KEEP_LIMIT_KB=65536
KEEP_RESTORED=""

# boneio.txt decides whether the eMMC is written at all, so it is read before
# dd. fix_emmc_rootfs reads it again for the board version; sourcing twice is
# harmless.
read_boneio_txt () {
	local mounted=false candidate
	if ! mountpoint -q /boot/firmware 2>/dev/null; then
		mkdir -p /boot/firmware
		if mount /dev/mmcblk0p1 /boot/firmware -o ro 2>/dev/null; then
			mounted=true
		fi
	fi
	for candidate in /boot/firmware/boneio.txt /boot/boneio.txt; do
		if [ -f "$candidate" ]; then
			. "$candidate"
			break
		fi
	done
	if $mounted; then
		umount /boot/firmware 2>/dev/null || true
	fi
}

# The ext4 root of the system already on the eMMC, in OLD_ROOTFS.
find_old_rootfs () {
	local i part
	OLD_ROOTFS=""
	for i in 1 2 3; do
		for part in "${DESTINATION}p${i}" "${DESTINATION}${i}"; do
			if [ -b "$part" ] && [ "$(blkid -s TYPE -o value "$part" 2>/dev/null)" = "ext4" ]; then
				OLD_ROOTFS="$part"
				return 0
			fi
		done
	done
	return 1
}

# Stop without touching the eMMC any further, and say so on the display.
recovery_abort () {
	message="ERROR: $1 $2 — nothing was written to the eMMC" ; broadcast
	oled_msg "$1" "$2" "eMMC unchanged"
	umount "$OLD_ROOT" 2>/dev/null || true
	if [ -n "$CYLON_PID" ]; then
		kill $CYLON_PID > /dev/null 2>&1 || true
	fi
	sync
	sleep 10
	halt -f
}

# BONEIO_RESET_ACCOUNTS=1: the panel accounts go, everything else stays.
reset_accounts () {
	local rc=0 cfg stamp
	message="INFO: BONEIO_RESET_ACCOUNTS=1 — resetting accounts, the eMMC is NOT reflashed" ; broadcast
	if [ "${BONEIO_KEEP_CONFIG:-}" = "1" ]; then
		message="WARN: BONEIO_KEEP_CONFIG ignored: a reset keeps everything anyway" ; broadcast
	fi
	oled_msg "Reset accounts" "Looking for the" "installed system"

	find_old_rootfs || recovery_abort "No system" "on the eMMC"
	# -p repairs only what is safe to repair unattended. A filesystem that
	# needs more is not one to write to from here.
	e2fsck -p "$OLD_ROOTFS" > /dev/null 2>&1 || rc=$?
	if [ "$rc" -gt 1 ]; then
		recovery_abort "eMMC needs a" "full fsck"
	fi
	mkdir -p "$OLD_ROOT"
	mount "$OLD_ROOTFS" "$OLD_ROOT" -o noatime || recovery_abort "Cannot mount" "the eMMC"

	cfg="$OLD_ROOT/home/boneio/boneio"
	stamp=$(date +%s)
	if [ -f "$cfg/users.json" ]; then
		# Moved, not deleted: whoever reset by mistake can put it back.
		mv "$cfg/users.json" "$cfg/users.json.reset-${stamp}" \
			|| recovery_abort "Cannot move" "users.json"
		message="INFO: Panel accounts moved to users.json.reset-${stamp}" ; broadcast
	else
		message="INFO: No users.json — the device was already waiting for the wizard" ; broadcast
	fi
	# The token key too. The panel checks only that a token's user exists, so
	# with the old key a token issued before the reset would work again the
	# moment the wizard recreates an account with the same name ("admin",
	# usually). boneIO draws a new key when the file is missing.
	if [ -f "$cfg/jwt_secret" ]; then
		mv "$cfg/jwt_secret" "$cfg/jwt_secret.reset-${stamp}" \
			|| recovery_abort "Cannot move" "jwt_secret"
		message="INFO: Old sessions invalidated (jwt_secret.reset-${stamp})" ; broadcast
	fi

	if [ -n "${BONEIO_EMMC_PASSWORD:-}" ]; then
		if chroot "$OLD_ROOT" /bin/sh -c "echo 'boneio:${BONEIO_EMMC_PASSWORD}' | chpasswd" 2>/dev/null; then
			chroot "$OLD_ROOT" chage -d "$(( $(date +%s) / 86400 ))" boneio 2>/dev/null || true
			message="WARN: boneio SSH password set from BONEIO_EMMC_PASSWORD (bench boards only)" ; broadcast
		else
			message="ERROR: Could not set the boneio password" ; broadcast
		fi
	elif chroot "$OLD_ROOT" passwd -l boneio > /dev/null 2>&1; then
		# Locked, as a new image ships it: the wizard's password becomes the
		# SSH one again.
		message="INFO: boneio SSH login locked until the first-run wizard sets it" ; broadcast
	else
		message="ERROR: Could not lock the boneio login" ; broadcast
	fi

	sync
	umount "$OLD_ROOT" || umount -l "$OLD_ROOT" || true

	if [ -n "$CYLON_PID" ]; then
		kill $CYLON_PID > /dev/null 2>&1 || true
	fi
	message="INFO: ===============================================" ; broadcast
	message="INFO: SUCCESS: accounts reset, configuration kept" ; broadcast
	message="INFO: Remove the SD card, boot, open the panel" ; broadcast
	message="INFO: ===============================================" ; broadcast
	oled_msg "Accounts reset" "Remove SD card," "then open panel"
	all_leds_on
	sleep 10
	sync
	if [ -f /proc/sysrq-trigger ] ; then
		echo s > /proc/sysrq-trigger || true
		sleep 1
	fi
	halt -f
}

# BONEIO_COLLECT_LOGS=1: read-only diagnostics of a controller that does not
# boot, written to the SD card's FAT partition so a PC can open them.
#
# The journal lives in RAM (log2ram); the eMMC has log2ram's copy in
# /var/hdd.log/journal, synced daily and at a clean shutdown, so the boot that
# failed is usually not in it. What is: everything up to the last sync, and —
# when the boot died before log2ram mounted — whatever journald wrote straight
# to /var/log/journal on the root filesystem. Both are read.
collect_logs () {
	local sd_boot="/tmp/sdboot" work="/tmp/boneio-logs" name out free need rc=0 dir
	message="INFO: BONEIO_COLLECT_LOGS=1 — reading logs off the eMMC (read-only)" ; broadcast
	oled_msg "Collect logs" "Reading the" "eMMC system"

	find_old_rootfs || recovery_abort "No system" "on the eMMC"
	rm -rf "$work"
	mkdir -p "$work"

	{
		echo "boneIO log collection — $(date -u '+%Y-%m-%d %H:%M:%S UTC') (the board's clock; it may be wrong)"
		echo "Flasher: ${version_message}"
		echo "Serial: $(tr -d '\0' 2>/dev/null < /proc/device-tree/serial-number || echo '?')"
		echo
		echo "== Partitions"
		sfdisk -l "${DESTINATION}" 2>&1 || true
		blkid "${DESTINATION}"* 2>&1 || true
		echo
		echo "== e2fsck -n ${OLD_ROOTFS} (read-only check, nothing repaired)"
		e2fsck -n -f "$OLD_ROOTFS" 2>&1 || true
		for part in "${DESTINATION}p1" "${DESTINATION}1"; do
			if [ -b "$part" ] && [ "$(blkid -s TYPE -o value "$part" 2>/dev/null)" = "vfat" ]; then
				echo
				echo "== fsck.fat -n ${part}"
				fsck.fat -n "$part" 2>&1 || true
			fi
		done
	} > "$work/summary.txt" 2>&1

	mkdir -p "$OLD_ROOT"
	mount "$OLD_ROOTFS" "$OLD_ROOT" -o ro 2>/dev/null \
		|| mount "$OLD_ROOTFS" "$OLD_ROOT" -o ro,noload 2>/dev/null \
		|| recovery_abort "Cannot read" "the eMMC system"

	{
		echo
		echo "== df"
		df -h "$OLD_ROOT" 2>&1 || true
		df -i "$OLD_ROOT" 2>&1 || true
		echo
		echo "== boneIO"
		ls -d "$OLD_ROOT"/home/boneio/boneio/venv/lib/python3*/site-packages/boneio-*.dist-info 2>/dev/null \
			| sed 's#.*/##' || true
		echo
		echo "== Applied system migrations"
		ls "$OLD_ROOT/var/lib/boneio/migrations.d" 2>&1 || true
		echo
		echo "== dpkg --audit (packages left half-installed)"
		dpkg --admindir="$OLD_ROOT/var/lib/dpkg" --audit 2>&1 || true
		echo
		echo "== uEnv.txt"
		cat "$OLD_ROOT/boot/uEnv.txt" 2>&1 || true
		echo
		echo "== fstab"
		cat "$OLD_ROOT/etc/fstab" 2>&1 || true
	} >> "$work/summary.txt" 2>&1

	# This boot, from the SD card: eMMC hardware errors show up here.
	dmesg > "$work/dmesg-sd-boot.txt" 2>&1 || true

	for dir in hdd.log/journal log/journal; do
		[ -d "$OLD_ROOT/var/$dir" ] || continue
		name=$(echo "$dir" | tr '/.' '--')
		journalctl -D "$OLD_ROOT/var/$dir" --list-boots --no-pager > "$work/${name}-boots.txt" 2>&1 || true
		journalctl -D "$OLD_ROOT/var/$dir" -o short-iso-precise --no-pager 2>/dev/null \
			| gzip -6 > "$work/${name}-all.txt.gz" || true
		journalctl -D "$OLD_ROOT/var/$dir" _TRANSPORT=kernel -o short-iso-precise --no-pager 2>/dev/null \
			| gzip -6 > "$work/${name}-kernel.txt.gz" || true
		journalctl -D "$OLD_ROOT/var/$dir" -p warning -o short-iso-precise --no-pager 2>/dev/null \
			| gzip -6 > "$work/${name}-warnings.txt.gz" || true
		journalctl -D "$OLD_ROOT/var/$dir" -u boneio -o short-iso-precise --no-pager 2>/dev/null \
			| gzip -6 > "$work/${name}-boneio.txt.gz" || true
	done
	# Plain log files next to the journal (apt, dpkg), capped.
	if [ -d "$OLD_ROOT/var/hdd.log" ]; then
		tar -C "$OLD_ROOT/var/hdd.log" --exclude=./journal -czf "$work/var-log-files.tar.gz" . 2>/dev/null || true
	fi
	# The configuration, for support — without secrets.yaml, accounts and keys.
	tar -C "$OLD_ROOT/home/boneio/boneio" --exclude=./venv --exclude='*.pkl' --exclude=__pycache__ \
		--exclude=./secrets.yaml --exclude='./users.json*' --exclude='./jwt_secret*' --exclude=./.env \
		-czf "$work/config-without-secrets.tar.gz" . 2>/dev/null || true

	umount "$OLD_ROOT" || umount -l "$OLD_ROOT" || true

	mkdir -p "$sd_boot"
	mount /dev/mmcblk0p1 "$sd_boot" 2>/dev/null || recovery_abort "Cannot write" "the SD card"
	name="boneio-logs-$(date -u +%Y%m%d-%H%M%S)"
	out="$sd_boot/$name"
	free=$(df -k "$sd_boot" | awk 'NR==2 {print $4}')
	need=$(du -sk "$work" | awk '{print $1}')
	# The FAT partition is small (tens of MB). The full exports go first when
	# they do not fit; the summary, kernel, warnings and boneIO logs are what
	# a diagnosis starts from.
	if [ "$need" -gt $(( free - 512 )) ]; then
		rm -f "$work"/*-all.txt.gz "$work/var-log-files.tar.gz"
		need=$(du -sk "$work" | awk '{print $1}')
		message="WARN: Not enough room on the SD card for the full journal; kept the essentials" ; broadcast
	fi
	mkdir -p "$out" && cp -r "$work"/. "$out"/ || rc=1
	sync
	umount "$sd_boot" || umount -l "$sd_boot" || true
	if [ "$rc" -ne 0 ]; then
		recovery_abort "Could not save" "logs to SD card"
	fi
	message="INFO: Logs saved on the SD card's boot partition: ${name}/ (${need} kB)" ; broadcast
	oled_msg "Logs saved" "on the SD card" "${name#boneio-logs-}"
}

# BONEIO_KEEP_CONFIG=1, before dd: copy what makes this controller this one.
keep_config_save () {
	local home size
	message="INFO: BONEIO_KEEP_CONFIG=1 — keeping the configuration across the reflash" ; broadcast
	oled_msg "Keep config" "Reading the old" "configuration"

	find_old_rootfs || recovery_abort "No old system" "to keep from"
	mkdir -p "$OLD_ROOT"
	# Read-only; noload as well when the journal is dirty, since a read-only
	# mount would otherwise refuse to replay it.
	mount "$OLD_ROOTFS" "$OLD_ROOT" -o ro 2>/dev/null \
		|| mount "$OLD_ROOTFS" "$OLD_ROOT" -o ro,noload 2>/dev/null \
		|| recovery_abort "Cannot read" "the old system"

	home="$OLD_ROOT/home/boneio"
	[ -f "$home/boneio/config.yaml" ] || recovery_abort "No config.yaml" "on the eMMC"

	size=$(du -sk --exclude=venv --exclude='*.pkl' \
		"$home/boneio" "$home/docker/nodered/node-red/data" 2>/dev/null \
		| awk '{s+=$1} END {print s+0}')
	if [ "$size" -gt "$KEEP_LIMIT_KB" ]; then
		recovery_abort "Config too big" "(${size} kB)"
	fi

	rm -rf "$KEEP_DIR"
	mkdir -p "$KEEP_DIR/config" "$KEEP_DIR/etc"
	# Panel accounts and the token key stay behind: the owner goes through the
	# wizard again, which is the point. The venv and caches belong to the
	# old image.
	( set -o pipefail
	  tar -C "$home/boneio" --exclude=./venv --exclude='*.pkl' --exclude=__pycache__ \
		--exclude=./users.json --exclude='./users.json.*' --exclude=./jwt_secret -cf - . \
		| tar -C "$KEEP_DIR/config" -xpf - ) || recovery_abort "Cannot copy" "the configuration"
	if [ -f "$home/boneiostate.json" ]; then
		cp -a "$home/boneiostate.json" "$KEEP_DIR/" || recovery_abort "Cannot copy" "boneiostate.json"
	fi
	if [ -d "$home/docker/nodered/node-red/data" ]; then
		mkdir -p "$KEEP_DIR/nodered"
		( set -o pipefail
		  tar -C "$home/docker/nodered/node-red/data" -cf - . | tar -C "$KEEP_DIR/nodered" -xpf - ) \
			|| recovery_abort "Cannot copy" "Node-RED flows"
	fi
	# The broker accounts, so Home Assistant keeps connecting with what it has.
	if [ -f "$OLD_ROOT/etc/mosquitto/passwd" ]; then
		cp -a "$OLD_ROOT/etc/mosquitto/passwd" "$KEEP_DIR/etc/mosquitto-passwd" \
			|| recovery_abort "Cannot copy" "MQTT accounts"
	fi
	if [ -f "$OLD_ROOT/etc/boneio/mqtt-boneio.pass" ]; then
		cp -a "$OLD_ROOT/etc/boneio/mqtt-boneio.pass" "$KEEP_DIR/etc/mqtt-boneio.pass" \
			|| recovery_abort "Cannot copy" "MQTT accounts"
	fi

	umount "$OLD_ROOT" || umount -l "$OLD_ROOT" || true
	message="INFO: Kept $(find "$KEEP_DIR" -type f | wc -l) files (${size} kB) in RAM for the new system" ; broadcast
}

# BONEIO_KEEP_CONFIG=1, after dd, with the new rootfs at /tmp/rootfs.
keep_config_restore () {
	local home="/tmp/rootfs/home/boneio" failed=""
	[ -d "$KEEP_DIR/config" ] || return 0
	# After dd, as PID 1 under bash -e: no step may end the script (that is a
	# kernel panic), so each one reports and the rest carry on.
	oled_msg "Setup system" "[=========-] 88%" "Restoring config"

	# The image's configuration goes whole: a file left from it would be read
	# beside the kept ones (by an !include_dir, say). Its venv stays.
	mkdir -p "$home/boneio" || true
	find "$home/boneio" -mindepth 1 -maxdepth 1 ! -name venv -exec rm -rf {} + || true
	( set -o pipefail
	  tar -C "$KEEP_DIR/config" -cf - . | tar -C "$home/boneio" -xpf - ) || failed="config"
	if [ -f "$KEEP_DIR/boneiostate.json" ]; then
		# Merged, not copied: the old state is the owner's, but the hardware
		# flags were just probed on this board (relay inversion, above), and an
		# install older than that probe has none.
		python3 - "$KEEP_DIR/boneiostate.json" "$home/boneiostate.json" <<'PYMERGE' || failed="$failed state"
import json, os, sys
kept, target = sys.argv[1], sys.argv[2]
with open(kept) as f:
    state = json.load(f)
fresh = {}
if os.path.exists(target):
    try:
        with open(target) as f:
            fresh = json.load(f)
    except ValueError:
        fresh = {}
if isinstance(state, dict) and isinstance(fresh.get("hardware"), dict):
    hw = state.setdefault("hardware", {})
    if isinstance(hw, dict):
        hw.update(fresh["hardware"])
with open(target, "w") as f:
    json.dump(state, f, indent=2)
PYMERGE
		chown 1000:1000 "$home/boneiostate.json" 2>/dev/null || true
	fi
	if [ -d "$KEEP_DIR/nodered" ]; then
		mkdir -p "$home/docker/nodered/node-red/data" || true
		find "$home/docker/nodered/node-red/data" -mindepth 1 -maxdepth 1 -exec rm -rf {} + || true
		( set -o pipefail
		  tar -C "$KEEP_DIR/nodered" -cf - . | tar -C "$home/docker/nodered/node-red/data" -xpf - ) \
			|| failed="$failed node-red"
	fi
	if [ -f "$KEEP_DIR/etc/mosquitto-passwd" ] \
		&& cp "$KEEP_DIR/etc/mosquitto-passwd" /tmp/rootfs/etc/mosquitto/passwd; then
		chroot /tmp/rootfs chown root:mosquitto /etc/mosquitto/passwd 2>/dev/null || true
		chmod 0640 /tmp/rootfs/etc/mosquitto/passwd || true
		if [ -f "$KEEP_DIR/etc/mqtt-boneio.pass" ]; then
			mkdir -p /tmp/rootfs/etc/boneio || true
			cp -a "$KEEP_DIR/etc/mqtt-boneio.pass" /tmp/rootfs/etc/boneio/mqtt-boneio.pass || true
		fi
		# The broker keeps its accounts, and secrets.yaml came along with the
		# config, so the per-device passwords drawn at first boot would only
		# break Home Assistant's connection. Mark that as done.
		mkdir -p /tmp/rootfs/var/lib/boneio || true
		touch /tmp/rootfs/var/lib/boneio/mqtt-firstboot.done || true
		message="INFO: Broker accounts kept; first-boot MQTT passwords skipped" ; broadcast
	elif [ -f "$KEEP_DIR/etc/mosquitto-passwd" ]; then
		failed="$failed mqtt"
	fi
	KEEP_RESTORED=1
	if [ -n "$failed" ]; then
		message="ERROR: Restoring the kept configuration failed for:${failed# }" ; broadcast
		oled_msg "Restore failed" "${failed# }" "See serial log"
		sleep 5
	else
		message="INFO: Configuration restored; the panel accounts start over with the wizard" ; broadcast
	fi
}

### Main ###

stabilize_system
startup_checks
read_boneio_txt
if [ "${BONEIO_COLLECT_LOGS:-}" = "1" ]; then
	collect_logs
	# Read-only on its own. Combined with a reset or a reinstall, the logs are
	# taken first, from the system as it was.
	if [ "${BONEIO_RESET_ACCOUNTS:-}" != "1" ] && [ "${BONEIO_KEEP_CONFIG:-}" != "1" ]; then
		if [ -n "$CYLON_PID" ]; then
			kill $CYLON_PID > /dev/null 2>&1 || true
		fi
		all_leds_on
		message="INFO: Done — remove the SD card and open boneio-logs-* on a PC" ; broadcast
		sleep 10
		sync
		halt -f
	fi
fi
if [ "${BONEIO_RESET_ACCOUNTS:-}" = "1" ]; then
	reset_accounts
fi
find_image_file
if [ "${BONEIO_KEEP_CONFIG:-}" = "1" ]; then
	keep_config_save
fi
FLASH_START_TIME=$(date +%s)
flash_emmc
fix_emmc_rootfs
if [ -d "$KEEP_DIR/config" ] && [ -z "$KEEP_RESTORED" ]; then
	# fix_emmc_rootfs gave up before it could restore, and the copy is in RAM.
	message="ERROR: The kept configuration could not be restored and is lost" ; broadcast
	oled_msg "Config NOT" "restored" "See serial log"
fi
station_boot_or_shutdown
