#!/bin/sh
# Early OLED boot splash — runs in initramfs before systemd.
# Uses i2ctransfer to write pre-rendered text to SH1106 OLED.
# Shows ~15s after power-on vs ~30s with systemd service.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac

I2C_BUS=2
ADDR=0x3c

# Check if i2c bus exists
[ -e /dev/i2c-${I2C_BUS} ] || exit 0
command -v i2ctransfer >/dev/null 2>&1 || exit 0

# SH1106 init sequence
for cmd in 0xAE 0xD5 0x80 0xA8 0x3F 0xD3 0x00 0x40 \
           0xAD 0x8B 0xA1 0xC8 0xDA 0x12 0x81 0xFF \
           0xD9 0x1F 0xDB 0x40 0xA6 0xAF; do
    i2ctransfer -y ${I2C_BUS} w2@${ADDR} 0x00 ${cmd} 2>/dev/null || exit 0
done

# Clear all 8 pages
Z="0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00"
for page in 0 1 2 3 4 5 6 7; do
    i2ctransfer -y ${I2C_BUS} w2@${ADDR} 0x00 $((0xB0 + page))
    i2ctransfer -y ${I2C_BUS} w2@${ADDR} 0x00 0x02
    i2ctransfer -y ${I2C_BUS} w2@${ADDR} 0x00 0x10
    for _ in 1 2 3 4; do
        i2ctransfer -y ${I2C_BUS} w33@${ADDR} 0x40 ${Z}
    done
done

# Pre-rendered "boneIO Black" (page 2, centered)
L1="0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x7f 0x48 0x44 0x44 0x38 0x00 0x38 0x44 0x44 0x44 0x38 0x00 0x7c 0x08 0x04 0x04 0x78 0x00 0x38 0x54 0x54 0x54 0x18 0x00 0x00 0x41 0x7f 0x41 0x00 0x00 0x3e 0x41 0x41 0x41 0x3e 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x7f 0x49 0x49 0x49 0x36 0x00 0x00 0x41 0x7f 0x40 0x00 0x00 0x20 0x54 0x54 0x54 0x78 0x00 0x38 0x44 0x44 0x44 0x20 0x00 0x7f 0x10 0x28 0x44 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00"

# Pre-rendered "Starting..." (page 5, centered)
L2="0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x46 0x49 0x49 0x49 0x31 0x00 0x04 0x3f 0x44 0x40 0x20 0x00 0x20 0x54 0x54 0x54 0x78 0x00 0x7c 0x08 0x04 0x04 0x08 0x00 0x04 0x3f 0x44 0x40 0x20 0x00 0x00 0x44 0x7d 0x40 0x00 0x00 0x7c 0x08 0x04 0x04 0x78 0x00 0x18 0xa4 0xa4 0xa4 0x7c 0x00 0x00 0x60 0x60 0x00 0x00 0x00 0x00 0x60 0x60 0x00 0x00 0x00 0x00 0x60 0x60 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00"

# Write line 1 to page 2
i2ctransfer -y ${I2C_BUS} w2@${ADDR} 0x00 0xB2
i2ctransfer -y ${I2C_BUS} w2@${ADDR} 0x00 0x02
i2ctransfer -y ${I2C_BUS} w2@${ADDR} 0x00 0x10
# Split into 32-byte chunks (i2c block limit)
echo "${L1}" | tr ' ' '\n' | {
    chunk=""
    count=0
    while read byte; do
        chunk="${chunk} ${byte}"
        count=$((count + 1))
        if [ ${count} -eq 32 ]; then
            i2ctransfer -y ${I2C_BUS} w33@${ADDR} 0x40 ${chunk}
            chunk=""
            count=0
        fi
    done
}

# Write line 2 to page 5
i2ctransfer -y ${I2C_BUS} w2@${ADDR} 0x00 0xB5
i2ctransfer -y ${I2C_BUS} w2@${ADDR} 0x00 0x02
i2ctransfer -y ${I2C_BUS} w2@${ADDR} 0x00 0x10
echo "${L2}" | tr ' ' '\n' | {
    chunk=""
    count=0
    while read byte; do
        chunk="${chunk} ${byte}"
        count=$((count + 1))
        if [ ${count} -eq 32 ]; then
            i2ctransfer -y ${I2C_BUS} w33@${ADDR} 0x40 ${chunk}
            chunk=""
            count=0
        fi
    done
}

# Signal that early splash was shown (for systemd service coordination)
: > /dev/.boneio-oled-done 2>/dev/null || true
